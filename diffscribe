def detect_language(filepath: str) -> str:
    """Detect the programming language from a file path."""
    basename = os.path.basename(filepath).lower()
    # Special filenames without extensions
    special = {
        "dockerfile": "Dockerfile",
        "makefile": "Makefile",
        "justfile": "Justfile",
        "rakefile": "Rakefile",
        "gemfile": "Ruby/Gemfile",
        "vagrantfile": "Vagrant",
    }
    if basename in special:
        return special[basename]

    _, ext = os.path.splitext(filepath)
    return LANGUAGE_MAP.get(ext, "")


def detect_scope(files: list[FileChange]) -> str:
    """
    Heuristic: suggest a scope based on directory structure.
    Uses the deepest common directory name that's meaningful.
    """
    dirs: list[str] = []
    for fc in files:
        parts = fc.path.split("/")
        if len(parts) > 1:
            dirs.append(parts[0])

    if not dirs:
        return ""

    # Count directory occurrences
    counts: dict[str, int] = defaultdict(int)
    for d in dirs:
        counts[d] += 1

    if not counts:
        return ""

    # Pick the most common directory
    best = max(counts, key=lambda k: counts[k])
    # Filter out generic dirs that don't make good scopes
    generic = {"src", "lib", "test", "tests", "spec", "scripts", "utils", "helpers"}
    if best.lower() in generic:
        # Try subdirectories
        subdirs: dict[str, int] = defaultdict(int)
        for fc in files:
            parts = fc.path.split("/")
            if len(parts) > 2:
                subdirs[parts[1]] += 1
        if subdirs:
            return max(subdirs, key=lambda k: subdirs[k])
        return best
    return best


def classify_file(fc: FileChange, diff_text: str) -> str:
    """Determine the commit type for a single file based on its path and diff."""
    path_lower = fc.path.lower()

    # Check path-based rules first
    if re.search(r"(readme|changelog|license|contributing|authors)", path_lower):
        return "docs"
    if re.search(r"(test|spec|__tests__|__mocks__|fixtures)/", path_lower) or path_lower.endswith((".test.js", ".test.ts", ".test.py", ".spec.js", ".spec.ts", ".spec.py", "_test.go", "_test.rs")):
        return "test"
    if re.search(r"(\.github|ci\.|\.gitlab|\.travis|\.circleci|jenkins|deploy|dockerfile|docker/k8s|terraform)", path_lower):
        return "ci"
    if re.search(r"(config|settings|\.env|webpack|vite|babel|\.eslint|\.prettier|tsconfig|postcss|tailwind)", path_lower):
        return "chore"
    if re.search(r"(style|css|sass|scss|less|theme|design.system)", path_lower):
        return "style"
    if re.search(r"(doc|docs)/", path_lower):
        return "docs"

    # Check diff content against patterns
    # Extract only the lines of diff relevant to this file
    file_diff = _extract_file_diff(diff_text, fc.path)
    combined = file_diff + " " + fc.path

    if _matches_any(combined, PERF_PATTERNS):
        return "perf"
    if _matches_any(combined, FIX_PATTERNS):
        return "fix"
    if _matches_any(combined, REFACTOR_PATTERNS):
        return "refactor"
    if _matches_any(combined, STYLE_PATTERNS):
        return "style"
    if _matches_any(combined, DOCS_PATTERNS):
        return "docs"
    if _matches_any(combined, TEST_PATTERNS):
        return "test"
    if fc.is_new:
        return "feat"

    return "chore"


def _extract_file_diff(diff_text: str, filepath: str) -> str:
    """Extract the diff hunk for a specific file from the full diff."""
    lines = diff_text.splitlines()
    in_file = False
    result: list[str] = []
    for line in lines:
        if line.startswith("diff --git"):
            # Check if this hunk is for our file
            if filepath in line:
                in_file = True
            else:
                if in_file:
                    break
                in_file = False
        if in_file and (line.startswith("+") or line.startswith("-")) and not line.startswith("+++") and not line.startswith("---"):
            result.append(line)
    return "\n".join(result)


def parse_diff_stat(stat_text: str) -> list[FileChange]:
    """Parse `git diff --cached --stat` output into FileChange objects."""
    changes: list[FileChange] = []
    for line in stat_text.strip().splitlines():
        line = line.strip()
        if not line or line.endswith("file(s) changed") or line.startswith(" "):
            continue
        # Typical: " path/to/file.py | 12 +++++------"
        # Or with binary: " image.png | Bin 0 -> 1234 bytes"
        match = re.match(r"(.+?)\s*\|\s*(.+)", line)
        if not match:
            continue

        filepath = match.group(1).strip()
        stat_part = match.group(2).strip()

        fc = FileChange(path=filepath)

        if stat_part.startswith("Bin"):
            # Binary file — skip detailed stats
            fc.additions = 0
            fc.deletions = 0
        else:
            # Parse additions and deletions
            add_match = re.search(r"(\d+)\s*\+", stat_part)
            del_match = re.search(r"(\d+)\s*-", stat_part)
            fc.additions = int(add_match.group(1)) if add_match else 0
            fc.deletions = int(del_match.group(1)) if del_match else 0

        # Detect if file is new or deleted by checking the staged name-status
        name_status = _run_git("diff", "--cached", "--name-status")
        for ns_line in name_status.strip().splitlines():
            parts = ns_line.split("\t", 1)
            if len(parts) >= 2 and parts[-1].strip() == filepath:
                status = parts[0].upper()
                if status.startswith("A"):
                    fc.is_new = True
                elif status.startswith("D"):
                    fc.is_deleted = True
                elif status.startswith("R"):
                    fc.is_rename = True
                break

        fc.language = detect_language(filepath)
        changes.append(fc)

    return changes


def determine_overall_type(files: list[FileChange]) -> str:
    """Determine the dominant commit type across all files."""
    type_counts: dict[str, int] = defaultdict(int)
    for fc in files:
        if fc.change_type:
            type_counts[fc.change_type] += 1

    if not type_counts:
        return "chore"

    # Priority order: feat > fix > perf > refactor > test > docs > ci > style > chore
    priority = ["feat", "fix", "perf", "refactor", "test", "docs", "ci", "style", "chore"]
    # Find the highest-priority type that has the most files
    max_count = max(type_counts.values())
    for t in priority:
        if type_counts.get(t) == max_count:
            return t

    # Fallback: alphabetically first of the tied types
    for t in priority:
        if t in type_counts:
            return t
    return "chore"


def generate_short_description(files: list[FileChange], commit_type: str, scope: str) -> str:
    """Generate a concise commit description based on file changes."""
    if len(files) == 1:
        fc = files[0]
        basename = os.path.basename(fc.path)
        # Singular descriptions
        if fc.is_new:
            # Check if it looks like a feature by existence of keywords in the basename
            if _matches_any(basename, [r"test", r"spec"]):
                return f"add {basename} test file"
            if fc.language:
                return f"add {fc.language} module {basename}"
            return f"add {basename}"
        if fc.is_deleted:
            return f"remove {basename}"
        if fc.change_type == "fix":
            return f"fix issue in {basename}"
        if fc.change_type == "docs":
            return f"update {basename} documentation"
        if fc.change_type == "style":
            return f"format {basename}"
        return f"update {basename}"

    # Multiple files: group by language or directory
    langs: dict[str, int] = defaultdict(int)
    for fc in files:
        lang = fc.language if fc.language else "files"
        langs[lang] += 1

    if len(langs) == 1:
        lang_name = list(langs.keys())[0]
        count = list(langs.values())[0]
        type_verb = {
            "feat": "add", "fix": "fix", "docs": "update docs",
            "refactor": "refactor", "perf": "optimize", "test": "add tests",
            "style": "format", "ci": "update CI", "chore": "update",
        }
        verb = type_verb.get(commit_type, "update")
        return f"{verb} {count} {lang_name} file{'s' if count > 1 else ''}"

    # Mixed files
    count = len(files)
    type_verb = {
        "feat": "add", "fix": "fix", "docs": "update docs",
        "refactor": "refactor", "perf": "optimize", "test": "add tests",
        "style": "format", "ci": "update CI", "chore": "update",
    }
    verb = type_verb.get(commit_type, "update")
    return f"{verb} {count} files"


def build_details(files: list[FileChange]) -> list[str]:
    """Build the body lines of the commit message with per-file details."""
    details: list[str] = []
    # Sort: new files first, then modified, then deleted
    for fc in files:
        prefix = ""
        if fc.is_new:
            prefix = "new: "
        elif fc.is_deleted:
            prefix = "removed: "
        elif fc.is_rename:
            prefix = "renamed: "
        stat = f"(+{fc.additions}/-{fc.deletions})" if not fc.is_deleted else ""
        detail = f"- {prefix}{fc.path} {stat}".strip()
        details.append(detail)
    return details


def analyze(stat_text: str, diff_text: str) -> DiffSummary:
    """Full analysis pipeline."""
    summary = DiffSummary()
    summary.files = parse_diff_stat(stat_text)

    if not summary.files:
        return summary

    # Classify each file
    for fc in summary.files:
        fc.change_type = classify_file(fc, diff_text)

    summary.total_additions = sum(fc.additions for fc in summary.files)
    summary.total_deletions = sum(fc.deletions for fc in summary.files)
    summary.suggested_type = determine_overall_type(summary.files)
    summary.suggested_scope = detect_scope(summary.files)
    summary.short_description = generate_short_description(
        summary.files, summary.suggested_type, summary.suggested_scope,
    )
    summary.details = build_details(summary.files)

    return summary


# ---------------------------------------------------------------------------
# Output formatting
# ---------------------------------------------------------------------------

def format_commit_message(summary: DiffSummary, scope: str = "", cta: bool = False) -> str:
    """Format the full conventional commit message."""
    scope = scope or summary.suggested_scope
    scope_str = f"({scope})" if scope else ""

    type_emoji = {
        "feat": "✨", "fix": "🐛", "docs": "📝", "style": "🎨",
        "refactor": "♻️", "perf": "⚡", "test": "✅", "ci": "👷",
        "chore": "🔧", "build": "📦", "revert": "⏪",
    }
    emoji = type_emoji.get(summary.suggested_type, "🔧")

    header = f"{emoji} {summary.suggested_type}{scope_str}: {summary.short_description}"

    lines = [header]

    if summary.details:
        lines.append("")
        lines.append("Changes:")
        lines.extend(summary.details[:20])  # Cap detail lines
        if len(summary.details) > 20:
            lines.append(f"- ... and {len(summary.details) - 20} more files")

    lines.append("")
    lines.append(f"[diffscribe] {summary.total_additions} additions, {summary.total_deletions} deletions across {len(summary.files)} file(s)")

    if cta:
        lines.append("")
        lines.append("Reviewed-by: diffscribe (automated analysis)")

    return "\n".join(lines)


def format_short_status(summary: DiffSummary) -> str:
    """Return a very short one-liner: type(scope): description."""
    scope_str = f"({summary.suggested_scope})" if summary.suggested_scope else ""
    return f"{summary.suggested_type}{scope_str}: {summary.short_description}"


