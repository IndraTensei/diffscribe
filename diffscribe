        else:
            print("Warning: Could not copy to clipboard (no clipboard tool found).", file=sys.stderr)
            print(commit_line)
        if not args.commit and not args.amend:
            return 0

    # Build commit message for --commit or --dry-run
    if args.signoff:
        # Use header from the formatted message + rich body with signoff
        header = (format_commit_message(summary, args.scope, args.cta) if args.emojis
                  else _format_commit_message_no_emoji(summary, args.scope, args.cta))
        # Extract just the first line (the header)
        header_line = header.splitlines()[0]
        body = build_rich_body(summary, signoff=True)
        message_with_signoff = header_line + body
    else:
        message_with_signoff = message

    if args.dry_run:
        print("[dry-run] Would commit with message:")
        print("─" * 50)
