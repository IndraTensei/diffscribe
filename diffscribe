# CLI entry point
# ---------------------------------------------------------------------------


def _format_commit_message_no_emoji(summary: DiffSummary, scope: str = "", cta: bool = False) -> str:
    """Format the full commit message without emojis."""
    scope = scope or summary.suggested_scope
    scope_str = f"({scope})" if scope else ""
    header = f"{summary.suggested_type}{scope_str}: {summary.short_description}"
    lines = [header]
    if summary.details:
        lines.append("")
        lines.append("Changes:")
        lines.extend(summary.details[:20])
        if len(summary.details) > 20:
            lines.append(f"- ... and {len(summary.details) - 20} more files")
    lines.append("")
    lines.append(f"[diffscribe] {summary.total_additions} additions, {summary.total_deletions} deletions across {len(summary.files)} file(s)")
    if cta:
        lines.append("")
        lines.append("Reviewed-by: diffscribe (automated analysis)")
    return "\n".join(lines)


def main() -> int:
    # Load config file first (before parsing CLI args, so CLI overrides config)
    cfg = load_config()

    parser = argparse.ArgumentParser(
        prog="diffscribe",
        description="Analyze staged git diffs and generate conventional commit messages.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
examples:
  diffscribe                    # Analyze and show suggested commit message
  diffscribe -s                 # Show short one-liner only
  diffscribe -i                 # Interactive mode (accept/edit/override)
  diffscribe --commit           # Analyze and immediately commit
  diffscribe --amend            # Amend the last commit with a new message
  diffscribe --copy             # Copy the message to clipboard
  diffscribe --type fix         # Override the detected commit type
  diffscribe --scope api        # Override the detected scope
  diffscribe --json             # Output machine-readable JSON
        """,
    )

    parser.add_argument(
        "-s", "--short",
        action="store_true",
        help="Print only the short one-line commit message",
    )
    parser.add_argument(
        "-i", "--interactive",
        action="store_true",
        help="Interactive mode: accept, edit, override, or skip",
    )
    parser.add_argument(
        "--commit",
        action="store_true",
        help="Automatically commit with the generated message",
    )
    parser.add_argument(
        "--amend",
        action="store_true",
        help="Amend the last commit with the generated message",
    )
    parser.add_argument(
        "--copy",
        action="store_true",
        dest="copy",
        help="Copy the generated message to the system clipboard",
    )
    parser.add_argument(
        "--type", "-t",
        dest="commit_type",
        choices=["feat", "fix", "docs", "style", "refactor", "perf", "test", "ci", "chore", "build", "revert"],
        help="Override the auto-detected commit type",
    )
    parser.add_argument(
        "--scope",
        dest="scope",
        default="",
        help="Override the auto-detected scope",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output analysis as JSON",
    )
    parser.add_argument(
        "--emojis",
        action="store_true",
        default=None,
        help="Include emoji in the commit message (default: on; can be set in .diffscribe config)",
    )
    parser.add_argument(
        "--no-emojis",
        action="store_false",
        dest="emojis",
        help="Disable emoji prefixes",
    )
    parser.add_argument(
        "--cta",
        action="store_true",
        default=False,
        help="Add a completion/tracking tail to the message",
    )
    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        default=False,
        help="Show detailed analysis output",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"diffscribe {__version__}",
    )

    args = parser.parse_args()

    # Apply config file defaults for args not explicitly set
    if args.emojis is None:
        args.emojis = cfg.get("emojis", True)
    if not args.scope and cfg.get("scope"):
        args.scope = cfg["scope"]
    if not args.commit_type and cfg.get("type"):
        args.commit_type = cfg["type"]
    if not args.cta and cfg.get("cta"):
        args.cta = cfg["cta"]
    if not args.verbose and cfg.get("verbose"):
        args.verbose = cfg["verbose"]

    # Verify we're in a git repo
    try:
        _run_git("rev-parse", "--is-inside-work-tree")
    except RuntimeError:
        print("Error: Not inside a git repository.", file=sys.stderr)
        return 1

    # Check for staged changes
    staged_diff = get_staged_diff()
    if not staged_diff.strip():
        print("No staged changes. Stage some files with `git add` first.")
        return 0

    stat_text = get_staged_diff(stat_only=True)
    summary = analyze(stat_text, staged_diff)

    if not summary.files:
        print("No analyzable staged changes found.")
        return 0

    # Branch-aware type/scope detection
    branch_name = get_branch_name()
    branch_type, branch_scope = detect_from_branch(branch_name)

    # Apply branch hints only when no explicit override is given
    if not args.commit_type and branch_type:
        summary.suggested_type = branch_type
    if not args.scope and branch_scope:
        summary.suggested_scope = branch_scope

    # Apply explicit overrides (CLI args / config)
    if args.commit_type:
        summary.suggested_type = args.commit_type
    if args.scope:
        summary.suggested_scope = args.scope
        summary.short_description = generate_short_description(
            summary.files, summary.suggested_type, args.scope,
        )

    # Handle --json output
    if args.json:
        import json
        message_text = _format_commit_message_no_emoji(summary, args.scope, args.cta) if not args.emojis else format_commit_message(summary, args.scope, args.cta)
        output = {
            "type": summary.suggested_type,
            "scope": summary.suggested_scope,
            "subject": summary.short_description,
            "additions": summary.total_additions,
            "deletions": summary.total_deletions,
            "files": [
                {
                    "path": fc.path,
                    "language": fc.language,
                    "additions": fc.additions,
                    "deletions": fc.deletions,
                    "type": fc.change_type,
                    "is_new": fc.is_new,
                    "is_deleted": fc.is_deleted,
                }
                for fc in summary.files
            ],
            "message": message_text,
        }
        print(json.dumps(output, indent=2))
        return 0

    # Handle --short
    if args.short:
        print(format_short_status(summary))
        return 0

    # Generate message
    if args.emojis:
        message = format_commit_message(summary, args.scope, args.cta)
    else:
        message = _format_commit_message_no_emoji(summary, args.scope, args.cta)

    # Handle verbose
    if args.verbose:
        print(f"Branch:      {get_branch_name()}")
        print(f"Repository:  {get_repo_name()}")
        print(f"Files:       {len(summary.files)}")
        print(f"Additions:   {summary.total_additions}")
        print(f"Deletions:   {summary.total_deletions}")
        # Show branch hint info
        if branch_type:
            print(f"Branch hint: type={branch_type}" + (f", scope={branch_scope}" if branch_scope else ""))
        print(f"Suggested:   {summary.suggested_type}" +
              (f"({summary.suggested_scope})" if summary.suggested_scope else ""))
        print()

    # Handle --copy (copy to clipboard, optionally also print)
    if args.copy:
        if args.emojis:
            full_msg = format_commit_message(summary, args.scope, args.cta)
            commit_line = full_msg.splitlines()[0]
        else:
            commit_line = format_short_status(summary)
        if copy_to_clipboard(commit_line):
            print(f"📋 Copied to clipboard: {commit_line}")
        else:
            print("Warning: Could not copy to clipboard (no clipboard tool found).", file=sys.stderr)
            print(commit_line)
        if not args.commit and not args.amend:
            return 0

    if args.commit:
        print(message)
        print()
        if do_commit(message):
            print("✅ Committed successfully!")
            return 0
        return 1

    if args.amend:
        print(message)
        print()
        if do_amend(message):
            print("✅ Amended last commit successfully!")
            return 0
        return 1

    if args.interactive:
        final_message = interactive_edit(message)
        if final_message:
            if do_commit(final_message):
                print("✅ Committed!")
            else:
                return 1
        else:
            print("Skipped. No commit made.")
        return 0

    # Default: just print the suggested message
    print(message)
    return 0


if __name__ == "__main__":
    sys.exit(main())
