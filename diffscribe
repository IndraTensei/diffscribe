def get_recent_commits(count: int = 10) -> list[dict]:
    """Return the N most recent commit messages with metadata."""
    fmt = "%H%x00%s%x00%an%x00%ar%x00"
    try:
        raw = _run_git("log", f"-n{count}", f"--pretty=format:{fmt}")
    except RuntimeError:
        return []

    commits = []
    for entry in raw.strip().split("\x00\x00"):
        entry = entry.strip("\x00").strip()
        if not entry:
            continue
        parts = entry.split("\x00")
        if len(parts) >= 4:
            commits.append({
                "hash": parts[0][:8],
                "subject": parts[1],
                "author": parts[2],
                "date": parts[3],
            })
    return commits


def display_commit_history(count: int = 10) -> None:
    """Print recent commit history in a formatted table."""
    commits = get_recent_commits(count)
    if not commits:
        print("No commit history found.")
        return

    print(f"\n📜 Recent {len(commits)} commit(s) for style reference:\n")
    # Determine column widths
    h_width = max(len(c["hash"]) for c in commits)
    d_width = max(len(c["date"]) for c in commits)

    for c in commits:
        print(f"  {c['hash']:<{h_width}}  {c['date']:<{d_width}}  {c['subject']}")
    print()


# ---------------------------------------------------------------------------
# Conventional Commit linter
# ---------------------------------------------------------------------------

# Regex for the Conventional Commits v1.0.0 spec
CONVENTIONAL_COMMIT_RE = re.compile(
    r"^(?P<type>build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
    r"(?P<breaking>!?)"
    r"(\((?P<scope>[a-z0-9_-]+)\))?"
    r"(?P<breaking2>!?)"
    r": "
    r"(?P<subject>.+)$"
)

# Allowed commit types from conventional commits spec
CONVENTIONAL_TYPES = [
    "build", "chore", "ci", "docs", "feat", "fix",
    "perf", "refactor", "revert", "style", "test",
]

# Common non-conventional patterns that trigger warnings
COMMON_MISTAKES = [
    (re.compile(r"^wip\b", re.I), "Starts with 'wip' — conventional commits should describe the result, not work-in-progress"),
    (re.compile(r"^update\b", re.I), "Starts with 'update' — consider a more specific type like 'feat', 'fix', or 'docs'"),
    (re.compile(r"^add\b", re.I), "Starts with 'add' — consider using 'feat' as the type if this adds functionality"),
    (re.compile(r"^remove\b", re.I), "Starts with 'remove' — consider 'refactor' or 'chore' as the type"),
    (re.compile(r"^change\b", re.I), "Starts with 'change' — consider a more descriptive type"),
    (re.compile(r"^bump\b", re.I), "Starts with 'bump' — consider 'chore' as the type for version bumps"),
    (re.compile(r"^merge\b", re.I), "Starts with 'merge' — merge commits usually don't need conventional format"),
    (re.compile(r"^typo\b", re.I), "Starts with 'typo' — consider 'fix' or 'docs' as the type"),
    (re.compile(r"^\.\.\.", re.I), "Starts with '...' — the subject should be a complete description"),
    (re.compile(r".{73,}", re.I), "Subject exceeds 72 characters — the header should be ≤72 chars"),
]


def lint_commit_message(message: str) -> dict:
    """
    Lint a commit message against the Conventional Commits v1.0.0 spec.

    Returns a dict:
    {
        "valid": bool,
        "matched": bool,
        "type": str or None,
        "scope": str or None,
        "subject": str or None,
        "breaking": bool,
        "errors": [str, ...],
        "warnings": [str, ...],
    }
    """
    result = {
        "valid": False,
        "matched": False,
        "type": None,
        "scope": None,
        "subject": None,
        "breaking": False,
        "errors": [],
        "warnings": [],
    }

    # Extract the first line (header)
    lines = message.strip().splitlines()
    if not lines or not lines[0].strip():
        result["errors"].append("Commit message is empty.")
        return result

    header = lines[0].strip()

    # Check length
    if len(header) > 72:
        result["warnings"].append(
            f"Header is {len(header)} characters (recommended max: 72)."
        )

    m = CONVENTIONAL_COMMIT_RE.match(header)
    if m:
        result["matched"] = True
        result["type"] = m.group("type")
        result["scope"] = m.group("scope")
        result["subject"] = m.group("subject")
        result["breaking"] = bool(m.group("breaking") or m.group("breaking2"))

        # Validate subject isn't empty
        if not m.group("subject").strip():
            result["errors"].append("Subject must not be empty after ': '.")
            return result

        # Check for trailing period in subject
        if m.group("subject").strip().endswith("."):
            result["warnings"].append(
                "Subject should not end with aperiod."
            )

        # Check subject doesn't start with uppercase
        subj = m.group("subject").strip()
        if subj and subj[0].isupper():
            result["warnings"].append(
                f"Subject '{subj}' should start with a lowercase letter."
            )

        # Multiple blank lines between header and body
        if len(lines) > 1:
            blank_count = 0
            for line in lines[1:]:
                if line.strip() == "":
                    blank_count += 1
                else:
                    break
            if blank_count == 0:
                result["warnings"].append(
                    "No blank line between header and body — "
                    "add a blank line after the first line."
                )
            elif blank_count > 1:
                result["warnings"].append(
                    f"Multiple blank lines ({blank_count}) between header and body — "
                    "only one is needed."
                )

        result["valid"] = len(result["errors"]) == 0
    else:
        result["matched"] = False
        result["errors"].append(
            f"Header does not match Conventional Commits format: '{header}'"
        )
        result["errors"].append(
            "Expected format: <type>[(scope)][!]: <subject>"
        )
        result["errors"].append(
            f"Allowed types: {', '.join(CONVENTIONAL_TYPES)}"
        )

        # Check for common mistakes
        for pattern, advice in COMMON_MISTAKES:
            if pattern.search(header):
                result["warnings"].append(advice)

    return result


def display_lint_result(result: dict) -> int:
    """Print lint results to stdout. Returns exit code (0=pass, 1=fail)."""
    if result["valid"]:
        print("✅ Commit message looks good!")
        parts = [f"type={result['type']}"]
        if result["scope"]:
            parts.append(f"scope={result['scope']}")
        if result["breaking"]:
            parts.append("BREAKING CHANGE")
        parts.append(f"subject=\"{result['subject']}\"")
        print(f"   {', '.join(parts)}")
    else:
        print("❌ Commit message does NOT conform to Conventional Commits:")
        for err in result["errors"]:
            print(f"   ✗ {err}")

    for warn in result["warnings"]:
        print(f"   ⚠ {warn}")

    return 0 if result["valid"] else 1


# ---------------------------------------------------------------------------
# Explain mode — show why the detected type/scope was chosen
# ---------------------------------------------------------------------------

def explain_analysis(summary: DiffSummary, branch_name: str, branch_type: str,
                     branch_scope: str, args) -> None:
    """Print a plain-English explanation of how diffscribe arrived at its suggestions."""
    lines = []
    lines.append("")
    lines.append("📖 Why this commit message?")
    lines.append("─" * 50)

    # Explain type detection
    type_reasons = []
    # Check what individual file types were found
    type_counts: dict[str, int] = defaultdict(int)
    for fc in summary.files:
        if fc.change_type:
            type_counts[fc.change_type] += 1

    if type_counts:
        breakdown = ", ".join(f"{t}: {c}" for t, c in sorted(type_counts.items(), key=lambda x: -x[1]))
        type_reasons.append(f"File classification found: {breakdown}")
        dominant = max(type_counts, key=lambda k: type_counts[k])
        type_reasons.append(f"Dominant file type is '{dominant}', so the commit type is '{summary.suggested_type}'")

    # Explain branch influence
    if branch_name:
        if branch_type:
            if args.commit_type:
                type_reasons.append(f"Branch '{branch_name}' suggests type='{branch_type}', but --type override applies")
            else:
                type_reasons.append(f"Branch '{branch_name}' matched pattern and contributed type='{branch_type}'")
        if branch_scope:
            if args.scope:
                type_reasons.append(f"Branch '{branch_name}' suggests scope='{branch_scope}', but --scope override applies")
            else:
                type_reasons.append(f"Branch '{branch_name}' matched pattern and contributed scope='{branch_scope}'")
        if not branch_type and not branch_scope:
            type_reasons.append(f"Branch '{branch_name}' did not follow conventional naming patterns")

    for reason in type_reasons:
        lines.append(f"  • {reason}")

    # Explain scope detection
    lines.append("")
    scope_reasons = []
    if summary.suggested_scope:
        # Reconstruct the scope logic
        dirs: dict[str, int] = defaultdict(int)
        for fc in summary.files:
            parts = fc.path.split("/")
            if len(parts) > 1:
                dirs[parts[0]] += 1
        if dirs:
            scope_reasons.append(f"Detected common directory '{summary.suggested_scope}' in {dirs.get(summary.suggested_scope, 0)}/{len(summary.files)} files")
        scope_reasons.append(f"Scope '{summary.suggested_scope}' will appear as the parenthesized segment in the header")
    else:
        scope_reasons.append("No common directory found across changed files — scope is omitted")

    for reason in scope_reasons:
        lines.append(f"  • {reason}")

    # Explain subject generation
    lines.append("")
    if len(summary.files) == 1:
        fc = summary.files[0]
        if fc.is_new:
            lines.append(f"  • Single new file detected — subject uses 'add' verb")
        elif fc.is_deleted:
            lines.append(f"  • Single file deletion detected — subject uses 'remove' verb")
        else:
            lines.append(f"  • Single modified file detected — subject uses 'update' verb")
    else:
        lines.append(f"  • {len(summary.files)} files changed — subject summarizes the group")

    # Explain overrides
    lines.append("")
    if args.commit_type:
        lines.append(f"  • Manual override: --type {args.commit_type} forced type (would have been '{determine_overall_type(summary.files)}')")
    if args.scope:
        lines.append(f"  • Manual override: --scope {args.scope} forced scope (would have been '{detect_scope(summary.files)}')")

    lines.append("")
    print("\n".join(lines))


# ---------------------------------------------------------------------------
# Compare mode — show diff between staged changes and a target ref
# ---------------------------------------------------------------------------

def compare_with_ref(ref: str) -> int:
    """
    Show a diff comparison between the currently staged changes and a target ref.
    Useful for generating contextual messages like "feat: 3 changes since v1.2.0".
    Returns exit code.
    """
    try:
        _run_git("rev-parse", ref)
    except RuntimeError:
        print(f"Error: Reference '{ref}' not found in this repository.", file=sys.stderr)
        return 1

    # Show stat of what's in the staged area vs the ref
    try:
        staged_stat = _run_git("diff", "--cached", "--stat").strip()
    except RuntimeError:
        print("Error: Could not read staged diff.", file=sys.stderr)
        return 1

    if not staged_stat:
        print("No staged changes to compare.")
        return 0

    # Get log messages between the ref and HEAD for context
    try:
        commits_since = _run_git("log", "--oneline", f"{ref}..HEAD", check=False).strip()
    except RuntimeError:
        commits_since = ""

    # Show the comparison
    print(f"📊 Comparing staged changes against '{ref}':")
    print("─" * 60)

    # Parse the staged diff for the summary
    stat_text = get_staged_diff(stat_only=True)
    diff_text = get_staged_diff()

    if not stat_text.strip():
        print("Nothing to compare.")
        return 0

    summary = analyze(stat_text, diff_text)

    # Show per-file summary
    for fc in summary.files:
        marker = ""
        if fc.is_new:
            marker = "(new)"
        elif fc.is_deleted:
            marker = "(deleted)"
        lang = f"[{fc.language}]" if fc.language else ""
        print(f"  {fc.path} {lang} (+{fc.additions}/-{fc.deletions}) {marker}".strip())

    print()
    print(f"  Files changed: {len(summary.files)}")
    print(f"  Insertions:    +{summary.total_additions}")
    print(f"  Deletions:     -{summary.total_deletions}")

    if commits_since:
        commit_lines = commits_since.splitlines()
        print(f"\n  Commits on HEAD since {ref}: {len(commit_lines)}")
        for cl in commit_lines[:5]:
            print(f"    {cl}")
        if len(commit_lines) > 5:
            print(f"    ... and {len(commit_lines) - 5} more commits")

    # Generate a contextual commit message
    try:
        ref_short = _run_git("rev-parse", "--short", ref).strip()
    except RuntimeError:
        ref_short = ref

    type_verb = {
        "feat": "add", "fix": "fix", "docs": "update docs",
        "refactor": "refactor", "perf": "optimize", "test": "add tests",
        "style": "format", "ci": "update CI", "chore": "update",
    }
    verb = type_verb.get(summary.suggested_type, "update")
    file_word = "file" if len(summary.files) == 1 else "files"
    suggested = f"{summary.suggested_type}({summary.suggested_scope or ''}): {verb} {len(summary.files)} {file_word} since {ref_short}"

    print(f"\n  Suggested contextual message:")
    print(f"    {suggested}")

    print("─" * 60)
    return 0


# ---------------------------------------------------------------------------
# Watch mode — monitor file changes and auto-suggest commits
# ---------------------------------------------------------------------------

def watch_mode(interval: float = 2.0) -> int:
    """
    Watch the working directory for changes, auto-stage them, and suggest
    a commit message when changes stabilize (no new changes for `interval` seconds).
    Exits on Ctrl+C.
    """
    import time

    try:
        _run_git("rev-parse", "--is-inside-work-tree")
    except RuntimeError:
        print("Error: Not inside a git repository.", file=sys.stderr)
        return 1

    print("👁️  Watching for changes... (Press Ctrl+C to stop, Enter to commit now)")
    print(f"    Auto-commit when changes stabilize for {interval}s\n")

    last_change_time = time.time()
    last_file_count = 0
    watching = True
    changes_detected = False

    while watching:
        try:
            # Check for any changes (staged or unstaged)
            status_output = _run_git("status", "--porcelain", check=False).strip()
            modified = [line for line in status_output.splitlines() if line.strip()]

            current_time = time.time()

            if modified:
                if not changes_detected:
                    changes_detected = True
                    print(f"  Detected {len(modified)} changed file(s):")
                    for m in modified[:5]:
                        print(f"    {m}")
                    if len(modified) > 5:
                        print(f"    ... and {len(modified) - 5} more")

                last_change_time = current_time
                last_file_count = len(modified)

            # If changes have stabilized, generate a suggestion
            if changes_detected and (current_time - last_change_time) >= interval:
                print(f"\n  Changes stabilized. Staging {last_file_count} file(s)...")

                # Auto-stage all changes
                _run_git("add", "-A")
                print("  Staged all changes.")

                # Generate commit suggestion
                stat_text = get_staged_diff(stat_only=True)
                if stat_text.strip():
                    diff_text = get_staged_diff()
                    summary = analyze(stat_text, diff_text)

                    branch_name = get_branch_name()
                    branch_type, branch_scope = detect_from_branch(branch_name)
                    if branch_type:
                        summary.suggested_type = branch_type
                    if branch_scope:
                        summary.suggested_scope = branch_scope

                    message = format_short_status(summary)
                    print(f"\n  Suggested: {message}")
                    print(f"  Type [y] to commit, [n] to skip, [e] to edit: ", end="", flush=True)

                    try:
                        response = input().strip().lower()
                    except (EOFError, KeyboardInterrupt):
                        print("\n  Stopped watching.")
                        return 0

                    if response in ("y", "yes", ""):
                        full_msg = format_commit_message(summary)
                        if do_commit(full_msg):
                            print("  Committed.")
                        else:
                            print("  Commit failed.")
                    elif response in ("e", "edit"):
                        full_msg = format_commit_message(summary)
                        edited = interactive_edit(full_msg)
                        if edited and do_commit(edited):
                            print("  Committed.")
                        else:
                            print("  Skipped or failed.")
                    else:
                        print("  Skipped. Unstaging...")
                        _run_git("reset", "HEAD", check=False)

                changes_detected = False

            time.sleep(0.5)

        except KeyboardInterrupt:
            print("\n\n  Stopped watching.")
            return 0

    return 0


