def do_commit(message: str) -> bool:
    """Execute git commit with the given message."""
    try:
        _run_git("commit", "-m", message)
        return True
    except RuntimeError as e:
        print(f"Commit failed: {e}", file=sys.stderr)
        return False


def do_amend(message: str) -> bool:
    """Amend the last commit with the given message."""
    try:
        _run_git("commit", "--amend", "-m", message)
        return True
    except RuntimeError as e:
        print(f"Amend failed: {e}", file=sys.stderr)
        return False


def copy_to_clipboard(text: str) -> bool:
    """Copy text to the system clipboard. Returns True on success."""
    # Try platform-specific clipboard commands
    clipboard_cmd = None
    if shutil.which("xclip"):
        clipboard_cmd = ["xclip", "-selection", "clipboard"]
    elif shutil.which("xsel"):
        clipboard_cmd = ["xsel", "--clipboard", "--input"]
    elif shutil.which("pbcopy"):
        clipboard_cmd = ["pbcopy"]
    elif shutil.which("wl-copy"):
        clipboard_cmd = ["wl-copy"]
    elif sys.platform == "win32":
        clipboard_cmd = ["clip"]
    elif sys.platform == "darwin" and not shutil.which("pbcopy"):
        # macOS without pbcopy — shouldn't happen
        pass

    if clipboard_cmd is None:
        return False

    try:
        proc = subprocess.run(
            clipboard_cmd,
            input=text.encode("utf-8"),
            timeout=10,
            capture_output=True,
        )
        return proc.returncode == 0
    except Exception:
        return False


