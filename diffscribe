# Default template used when --template is not specified
DEFAULT_TEMPLATE = "{emoji} {type}{scope}: {subject}"

# Available template placeholders:
#   {emoji}    — emoji prefix (✨, 🐛, etc.) or empty if --no-emojis
#   {type}     — commit type (feat, fix, docs, …)
#   {scope}    — commit scope in parentheses, e.g. "(api)" or empty
#   {subject}  — short subject description
#   {files}    — number of changed files
#   {additions} — number of additions
#   {deletions} — number of deletions
#   {branch}   — current branch name
#   {repo}     — repository name
#   {hash}     — short SHA of HEAD commit (or "uncommitted")
#   {date}     — current date in YYYY-MM-DD format

TEMPLATE_PLACEHOLDERS = [
    "emoji", "type", "scope", "subject", "files", "additions",
    "deletions", "branch", "repo", "hash", "date",
]


def _resolve_template(template: str, summary: DiffSummary,
                      emojis: bool = True) -> str:
    """Render a commit message from a user-supplied template string."""
    type_emoji = {
        "feat": "✨", "fix": "🐛", "docs": "📝", "style": "🎨",
        "refactor": "♻️", "perf": "⚡", "test": "✅", "ci": "👷",
        "chore": "🔧", "build": "📦", "revert": "⏪",
    }
    emoji = type_emoji.get(summary.suggested_type, "🔧") if emojis else ""
    scope_str = f"({summary.suggested_scope})" if summary.suggested_scope else ""

    # Gather context values
    from datetime import datetime
    branch_name = get_branch_name()
    repo_name = get_repo_name()
    try:
        short_hash = _run_git("rev-parse", "--short", "HEAD").strip()
    except Exception:
        short_hash = "uncommitted"
    today = datetime.now().strftime("%Y-%m-%d")

    replacements = {
        "emoji": emoji,
        "type": summary.suggested_type,
        "scope": scope_str,
        "subject": summary.short_description,
        "files": str(len(summary.files)),
        "additions": str(summary.total_additions),
        "deletions": str(summary.total_deletions),
        "branch": branch_name,
        "repo": repo_name,
        "hash": short_hash,
        "date": today,
    }

    result = template
    for key, val in replacements.items():
        result = result.replace("{" + key + "}", val)
    return result


