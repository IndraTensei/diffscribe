def render_diff_bar(additions: int, deletions: int, width: int = 20) -> str:
    """Render an ASCII bar showing the ratio of additions vs deletions."""
    total = additions + deletions
    if total == 0:
        return "│" + " " * width + "│"
    add_units = max(1, int(width * additions / total)) if additions > 0 else 0
    del_units = width - add_units
    if del_units == 0 and deletions > 0:
        del_units = 1
        add_units = width - 1
    bar = "+" * add_units + "-" * del_units
    return f"│{bar}│ +{additions}/-{deletions}"

