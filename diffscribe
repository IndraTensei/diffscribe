def interactive_edit(message: str) -> str:
    """Allow the user to type a custom message override."""
    print("\nSuggested commit message:")
    print("─" * 50)
    print(message)
    print("─" * 50)
    print("\nOptions: [a]ccept  [e]dit  [d]escribe (type your own)  [s]kip")
    try:
        choice = input("> ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return message

    if choice in ("a", "accept", ""):
        return message
    if choice in ("s", "skip"):
        return ""
    if choice in ("d", "describe"):
        print("Type your commit message (single line):")
        try:
            custom = input("subject> ").strip()
            return custom if custom else message
        except (EOFError, KeyboardInterrupt):
            print()
            return message
    if choice in ("e", "edit"):
        # Open in $EDITOR
        import tempfile
        editor = os.environ.get("EDITOR", "nano")
        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
            f.write(message)
            f.write("\n")
            tmp_path = f.name
        try:
            subprocess.run([editor, tmp_path], check=True)
            with open(tmp_path) as f:
                edited = f.read().strip()
            return edited if edited else message
        except Exception:
            return message
        finally:
            os.unlink(tmp_path)

    return message


# ---------------------------------------------------------------------------
# Commit execution
# ---------------------------------------------------------------------------

def do_commit(message: str) -> bool:
    """Execute git commit with the given message."""
    try:
        _run_git("commit", "-m", message)
        return True
    except RuntimeError as e:
        print(f"Commit failed: {e}", file=sys.stderr)
        return False


def do_amend(message: str) -> bool:
    """Amend the last commit with the given message."""
    try:
        _run_git("commit", "--amend", "-m", message)
        return True
    except RuntimeError as e:
        print(f"Amend failed: {e}", file=sys.stderr)
        return False


def copy_to_clipboard(text: str) -> bool:
    """Copy text to the system clipboard. Returns True on success."""
    # Try platform-specific clipboard commands
    clipboard_cmd = None
    if shutil.which("xclip"):
        clipboard_cmd = ["xclip", "-selection", "clipboard"]
    elif shutil.which("xsel"):
        clipboard_cmd = ["xsel", "--clipboard", "--input"]
    elif shutil.which("pbcopy"):
        clipboard_cmd = ["pbcopy"]
    elif shutil.which("wl-copy"):
        clipboard_cmd = ["wl-copy"]
    elif sys.platform == "win32":
        clipboard_cmd = ["clip"]
    elif sys.platform == "darwin" and not shutil.which("pbcopy"):
        # macOS without pbcopy — shouldn't happen
        pass

    if clipboard_cmd is None:
        return False

    try:
        proc = subprocess.run(
            clipboard_cmd,
            input=text.encode("utf-8"),
            timeout=10,
            capture_output=True,
        )
        return proc.returncode == 0
    except Exception:
        return False


