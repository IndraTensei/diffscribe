def interactive_edit(message: str) -> str:
    """Allow the user to type a custom message override."""
    print("\nSuggested commit message:")
    print("─" * 50)
    print(message)
    print("─" * 50)
    print("\nOptions: [a]ccept  [e]dit  [d]escribe (type your own)  [s]kip")
    try:
        choice = input("> ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return message

    if choice in ("a", "accept", ""):
        return message
    if choice in ("s", "skip"):
        return ""
    if choice in ("d", "describe"):
        print("Type your commit message (single line):")
        try:
            custom = input("subject> ").strip()
            return custom if custom else message
        except (EOFError, KeyboardInterrupt):
            print()
            return message
    if choice in ("e", "edit"):
        # Open in $EDITOR
        import tempfile
        editor = os.environ.get("EDITOR", "nano")
        with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
            f.write(message)
            f.write("\n")
            tmp_path = f.name
        try:
            subprocess.run([editor, tmp_path], check=True)
            with open(tmp_path) as f:
                edited = f.read().strip()
            return edited if edited else message
        except Exception:
            return message
        finally:
            os.unlink(tmp_path)

    return message


