#!/usr/bin/env python3
"""
diffscribe — Analyze staged git diffs and generate conventional commit messages.

A zero-dependency CLI tool that reads your staged git diff, categorizes changes,
detects scope, and outputs a well-structured conventional commit message.
No API keys, no AI models — just smart diff analysis.
"""

__version__ = "1.2.0"

import os
import re
import shutil
import subprocess
import sys
import argparse
from collections import defaultdict
from dataclasses import dataclass, field


# ---------------------------------------------------------------------------
# Data models
# ---------------------------------------------------------------------------

@dataclass
class FileChange:
    """Represents the changes detected in a single file."""
    path: str
    additions: int = 0
    deletions: int = 0
    is_new: bool = False
    is_deleted: bool = False
    is_rename: bool = False
    language: str = ""
    change_type: str = ""  # feature, fix, refactor, docs, test, chore, style, perf


@dataclass
class DiffSummary:
    """Aggregated summary of all staged changes."""
    files: list = field(default_factory=list)
    total_additions: int = 0
    total_deletions: int = 0
    suggested_type: str = "chore"
    suggested_scope: str = ""
    short_description: str = ""
    details: list = field(default_factory=list)


