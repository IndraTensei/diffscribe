    if args.commit:
        print(message_with_signoff)
        print()
        if do_commit(message_with_signoff):
            print("✅ Committed successfully!")
            return 0
        return 1

    if args.amend:
        print(message_with_signoff)
        print()
        if do_amend(message_with_signoff):
            print("✅ Amended last commit successfully!")
            return 0
        return 1

    if args.interactive:
        final_message = interactive_edit(message)
        if final_message:
            if do_commit(final_message):
                print("✅ Committed!")
            else:
                return 1
        else:
            print("Skipped. No commit made.")
        return 0

    # Default: just print the suggested message
    print(message_with_signoff)

    # Show explanation if requested
    if args.explain:
        explain_analysis(summary, branch_name, branch_type, branch_scope, args)

    return 0


