def find_config_path() -> str:
    """Look for .diffscribe config files in the current directory and parents."""
    candidates = [
        ".diffscribe.toml",
        ".diffscribe.json",
        ".config/.diffscribe.toml",
        ".config/.diffscribe.json",
    ]
    cur = os.getcwd()
    while True:
        for name in candidates:
            full = os.path.join(cur, name)
            if os.path.isfile(full):
                return full
        parent = os.path.dirname(cur)
        if parent == cur:
            break
        cur = parent
    return ""


def load_config() -> dict:
    """Load config from a .diffscribe.toml or .diffscribe.json file."""
    path = find_config_path()
    if not path:
        return dict(DEFAULT_CONFIG)

    try:
        if path.endswith(".toml"):
            # Try tomllib first (Python 3.11+), fallback to toml, else skip
            try:
                import tomllib
                with open(path, "rb") as f:
                    raw = tomllib.load(f)
            except ImportError:
                try:
                    import tomli as tomllib
                    with open(path, "rb") as f:
                        raw = tomllib.load(f)
                except ImportError:
                    # Fallback: minimal TOML-like parser for our simple cases
                    raw = _parse_minimal_toml(path)
        else:
            import json
            with open(path) as f:
                raw = json.load(f)

        # Support [[diffscribe]] table (TOML) or top-level (JSON)
        if isinstance(raw, dict):
            if "diffscribe" in raw:
                raw = raw["diffscribe"]
            cfg = dict(DEFAULT_CONFIG)
            for key in ("emojis", "type", "scope", "cta", "verbose"):
                if key in raw:
                    cfg[key] = raw[key]
            return cfg
    except Exception:
        pass

    return dict(DEFAULT_CONFIG)


def _parse_minimal_toml(path: str) -> dict:
    """Minimal TOML parser — handles flat key = value and [section] headers."""
    result: dict = {}
    current_section = result
    section_map: dict = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            section_match = re.match(r"^\[(.+?)\]$", line)
            if section_match:
                name = section_match.group(1).strip()
                current_section = {}
                section_map[name] = current_section
                continue
            kv_match = re.match(r'^(\w+)\s*=\s*(.+)$', line)
            if kv_match:
                key = kv_match.group(1).strip()
                val = kv_match.group(2).strip()
                # Strip quotes
                if val.startswith('"') and val.endswith('"'):
                    val = val[1:-1]
                elif val.startswith("'") and val.endswith("'"):
                    val = val[1:-1]
                # Booleans
                elif val.lower() == "true":
                    val = True
                elif val.lower() == "false":
                    val = False
                # Numbers
                else:
                    try:
                        val = int(val)
                    except ValueError:
                        try:
                            val = float(val)
                        except ValueError:
                            pass
                current_section[key] = val
    # Merge sections: top-level keys + all section values
    merged = dict(result)
    for s in section_map.values():
        merged.update(s)
    return merged


# ---------------------------------------------------------------------------
# Branch-aware type/scope detection
# ---------------------------------------------------------------------------

# Matches branch names like: feature/add-login, fix/memory-leak, docs/readme, feat/api-auth
BRANCH_TYPE_RE = re.compile(
    r"^(?P<trunk>[^/]+/)?"
    r"(?P<type>feat|feature|fix|bugfix|hotfix|bug|docs|doc|style|refactor|refact|perf|performance|test|testing|ci|chore|build|revert|release)"
    r"(/(?P<scope>.+))?$"
)

# Simpler pattern for common branches without type prefix (just scope)
BRANCH_SCOPE_RE = re.compile(
    r"^(?P<scope>[a-zA-Z0-9_-]+)/(?P<rest>.+)$"
)


def detect_from_branch(branch_name: str) -> tuple:
    """
    Parse the branch name to guess commit type and scope.
    Returns (type_hint, scope_hint) — either may be empty string.

    Examples:
        feature/api-auth  → ("feat", "api-auth")
        fix/memory-leak   → ("fix", "memory-leak")
        docs/readme       → ("docs", "readme")
        main              → ("", "")
    """
    # Strip common remote prefixes
    for prefix in ("origin/", "refs/heads/"):
        if branch_name.startswith(prefix):
            branch_name = branch_name[len(prefix):]

    m = BRANCH_TYPE_RE.match(branch_name)
    if m:
        raw_type = m.group("type") or ""
        mapped = CONVENTIONAL_TYPE_PREFIXES.get(raw_type, "")
        detected_scope = m.group("scope") or ""
        return (mapped, detected_scope)

    # For branches like "some-scope/description", extract scope if it looks meaningful
    m2 = BRANCH_SCOPE_RE.match(branch_name)
    if m2:
        candidate_scope = m2.group("scope")
        # Don't use generic names as scope
        generic = {"src", "lib", "test", "tests", "spec", "scripts", "utils", "helpers"}
        if candidate_scope.lower() not in generic:
            return ("", candidate_scope)

    return ("", "")


def _matches_any(text: str, patterns: list[str]) -> bool:
    lower = text.lower()
    return any(re.search(p, lower) for p in patterns)


# ---------------------------------------------------------------------------
# Git interaction
# ---------------------------------------------------------------------------

def _run_git(*args) -> str:
    """Run a git command and return stdout. Raises on failure."""
    cmd = ["git"] + list(args)
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode != 0 and result.stderr:
            # Some git commands write to stderr for info; only raise on real errors
            if "fatal" in result.stderr.lower() or "error" in result.stderr.lower():
                raise RuntimeError(f"git {' '.join(args)} failed:\n{result.stderr.strip()}")
        return result.stdout
    except FileNotFoundError:
        raise RuntimeError("Git is not installed or not in PATH.")


def get_staged_diff(stat_only: bool = False) -> str:
    """Return the staged diff (or stat) as a string."""
    if stat_only:
        return _run_git("diff", "--cached", "--stat")
    return _run_git("diff", "--cached", "--no-color")


def get_staged_files() -> list[str]:
    """Return list of staged file paths."""
    output = _run_git("diff", "--cached", "--name-status")
    files = []
    for line in output.strip().splitlines():
        if not line.strip():
            continue
        parts = line.split("\t", 1)
        if len(parts) >= 2:
            files.append(parts[-1].strip())
        else:
            files.append(parts[0].strip())
    return files


def get_branch_name() -> str:
    """Return current branch name, or empty string."""
    try:
        return _run_git("rev-parse", "--abbrev-ref", "HEAD").strip()
    except Exception:
        return ""


def get_repo_name() -> str:
    """Return the repository name from remote URL or directory name."""
    try:
        url = _run_git("remote", "get-url", "origin").strip()
        # Extract repo name from URL
        name = url.rstrip("/").split("/")[-1]
        if name.endswith(".git"):
            name = name[:-4]
        return name
    except Exception:
        return os.path.basename(os.getcwd())


