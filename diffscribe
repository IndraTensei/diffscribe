HOOK_SCRIPT = (
    "#!/usr/bin/env bash\n"
    "# diffscribe git hook — prepare-commit-msg\n"
    "# Installs diffscribe as a prepare-commit-msg hook that auto-generates\n"
    "# commit messages when the user does not provide one.\n"
    "set -euo pipefail\n"
    "\n"
    "# Only auto-generate if no commit message provided (i.e., editor would open)\n"
    'if [ -z "$2" ]; then\n'
    '    MESSAGE="$(diffscribe --no-emojis -s 2>/dev/null || echo "")"\n'
    '    if [ -n "$MESSAGE" ]; then\n'
    '        echo "$MESSAGE" > "$1"\n'
    "    fi\n"
    "fi\n"
)

HOOK_PATH = ".git/hooks/prepare-commit-msg"


def install_hook(force: bool = False) -> bool:
    """Install the diffscribe prepare-commit-msg hook into the current repo."""
    try:
        _run_git("rev-parse", "--is-inside-work-tree")
    except RuntimeError:
        print("Error: Not inside a git repository.", file=sys.stderr)
        return False

    hook_path = os.path.join(os.getcwd(), HOOK_PATH)

    if os.path.exists(hook_path) and not force:
        print(f"Hook already exists: {hook_path}")
        print("Use --hook --force to overwrite.")
        return False

    os.makedirs(os.path.dirname(hook_path), exist_ok=True)
    with open(hook_path, "w") as f:
        f.write(HOOK_SCRIPT)
    os.chmod(hook_path, 0o755)
    print(f"✅ Installed diffscribe prepare-commit-msg hook -> {hook_path}")
    print("   diffscribe will auto-generate commit messages when you commit without -m.")
    return True


# ---------------------------------------------------------------------------
# Rich commit body template
# ---------------------------------------------------------------------------

def build_rich_body(summary: DiffSummary, signoff: bool = False) -> str:
    """Build a rich commit message body with stats and file breakdown."""
    lines = []

    # File change summary by type
    type_groups: dict[str, list] = defaultdict(list)
    for fc in summary.files:
        label = fc.change_type or "change"
        type_groups[label].append(fc)

    if type_groups:
        lines.append("")
        lines.append("Changes:")
        priority = ["feat", "fix", "perf", "refactor", "test", "docs", "ci", "style", "chore"]
        ordered = []
        for t in priority:
            if t in type_groups:
                ordered.append(t)
        for t in type_groups:
            if t not in priority:
                ordered.append(t)

        for t in ordered:
            fcs = type_groups[t]
            if len(fcs) <= 3:
                for fc in fcs:
                    prefix = ""
                    if fc.is_new:
                        prefix = "(new) "
                    elif fc.is_deleted:
                        prefix = "(deleted) "
                    lines.append(f"- {prefix}{fc.path} (+{fc.additions}/-{fc.deletions})")
            else:
                lines.append(f"- {t}: {len(fcs)} file(s)")
                for fc in fcs[:2]:
                    lines.append(f"  - {fc.path} (+{fc.additions}/-{fc.deletions})")
                if len(fcs) > 2:
                    lines.append(f"  - ... and {len(fcs) - 2} more")

    # Stats summary
    lines.append("")
    total = summary.total_additions + summary.total_deletions
    if total > 0:
        add_pct = int(100 * summary.total_additions / total)
        del_pct = 100 - add_pct
        lines.append(f"[diffscribe] +{summary.total_additions}/-{summary.total_deletions} "
                     f"(+{add_pct}%/-{del_pct}%) across {len(summary.files)} file(s)")
    else:
        lines.append(f"[diffscribe] {len(summary.files)} file(s)")

    if signoff:
        lines.append("")
        lines.append("Signed-off-by: diffscribe <noreply@indratensei.dev>")

    return "\n".join(lines)


